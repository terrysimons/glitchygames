# direnv configuration for the sprite QuickLook extensions (https://direnv.net). Run `direnv allow`
# once to trust it.

# The repo's own .envrc (uv sync, git hooks, pulseaudio): a nested .envrc replaces its parent's
# unless it sources it
source_up

# XcodeGen generates App/SpritePreview.xcodeproj from App/project.yml (make project)
if [[ "$(uname -s)" == "Darwin" ]] && has brew; then
  if ! has xcodegen; then
    log_status "installing xcodegen with Homebrew (once)"
    brew install xcodegen
  fi
fi
