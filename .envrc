# direnv configuration for GlitchyGames (https://direnv.net). Run `direnv allow` once to trust it.

# The project's environment, exactly as uv.lock pins it (fast when nothing changed). Upgrading is
# deliberate: run `uv sync --upgrade --all-extras --all-groups` and review the uv.lock change.
if has uv; then
  uv sync --all-extras --all-groups
fi

# macOS: PulseAudio lets the Linux test container (nox -s test-linux-x11, which forwards its
# windows to XQuartz) play its sound on the Mac's speakers, over TCP.
if [[ "$(uname -s)" == "Darwin" ]] && has brew; then
  if ! brew list --versions pulseaudio >/dev/null 2>&1; then
    log_status "installing pulseaudio with Homebrew (once)"
    brew install pulseaudio
  fi
fi
