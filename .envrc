# direnv configuration for GlitchyGames (https://direnv.net). Run `direnv allow` once to trust it.

# The project's environment, exactly as uv.lock pins it (fast when nothing changed). Upgrading is
# deliberate: run `uv sync --upgrade --all-extras --all-groups --all-packages` and review the
# uv.lock change.
if has uv; then
  # --all-packages: the workspace members too (src/games/mr-muncher); without it the exact sync
  # would uninstall them
  uv sync --all-extras --all-groups --all-packages
  # The git hooks (.pre-commit-config.yaml): the pre-push checks. No commit hook since the owner
  # stopped committing replay-ledger rows (2026-11-22); a clone that still has the old
  # pre-commit shim runs it as a no-op. Installed only when missing (a fresh clone): pre-commit
  # install refuses whenever core.hooksPath is set, even to the default .git/hooks
  hooks_directory="$(git rev-parse --git-path hooks)"
  if [[ ! -x "$hooks_directory/pre-push" ]]; then
    log_status "installing the git hooks (pre-commit install)"
    uv run --extra dev pre-commit install
  fi
  # Whether just installed or already there: the pre-push shim clears O_NONBLOCK on stdout and
  # stderr before pre-commit starts (OpenSSH leaves them non-blocking, and a push piped into a
  # slow reader died with BlockingIOError). Idempotent; pre-commit install rewrites the shim,
  # so this runs on every entry (scripts/patch_pre_push_hook.py, bugs/2026-11-20-pre-push-...)
  uv run python -m scripts.patch_pre_push_hook \
    || log_status "the pre-push hook was not patched: see scripts/patch_pre_push_hook.py"
fi

# syft and grype: nox -s security-scan writes the SBOM with syft and scans it with grype (system
# binaries, not Python packages; CircleCI installs the versions .circleci/config.yml pins, and
# the SBOM names the syft that wrote it). macOS installs them with Homebrew; elsewhere, say how
# (adapted from exoneris .envrc's syft/grype install)
for supply_chain_tool in syft grype; do
  if ! has "$supply_chain_tool"; then
    if [[ "$(uname -s)" == "Darwin" ]] && has brew; then
      log_status "installing $supply_chain_tool with Homebrew (once)"
      brew install "$supply_chain_tool"
    else
      log_status "$supply_chain_tool not found: nox -s security-scan skips its SBOM, CVE and license scan (https://github.com/anchore/$supply_chain_tool#installation)"
    fi
  fi
done

# macOS: PulseAudio lets the Linux test container (nox -s test-linux-x11, which forwards its
# windows to XQuartz) play its sound on the Mac's speakers, over TCP.
if [[ "$(uname -s)" == "Darwin" ]] && has brew; then
  if ! brew list --versions pulseaudio >/dev/null 2>&1; then
    log_status "installing pulseaudio with Homebrew (once)"
    brew install pulseaudio
  fi
fi
