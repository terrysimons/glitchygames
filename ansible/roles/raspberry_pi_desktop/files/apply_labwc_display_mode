#!/bin/sh
# Apply a labwc session's display mode with wlr-randr (Raspberry Pi OS).
#
#   apply_labwc_display_mode WIDTH HEIGHT REFRESH_RATES   (rates most wanted first, comma-separated)
#
# Run as the session's user in its session (ansible/roles/raspberry_pi_desktop: its autostart
# entry at each login, and each deploy). wlr-randr reports the outputs; the planner beside this
# script (the one GNOME's apply_display_mode uses) reads them and prints "<action> <connector>
# <mode>"; this prints that line and, on apply, sets the mode at scale 1 with wlr-randr. labwc
# keeps a mode once set, so unlike GNOME it needs no confirming. With no Wayland session to ask
# (before the runner's session first starts) it prints "skip - -" and succeeds, as GNOME's does.
# Exits 1 when the plan fails, else with wlr-randr's status (0 when nothing to do).
# Tests: tests/test_ansible_raspberry_pis.py
set -eu

here=$(dirname "$0")
if ! outputs=$(wlr-randr --json 2>/dev/null); then
    printf 'skip - -\n'
    exit 0
fi
plan=$(printf '%s\n' "$outputs" | /usr/bin/env python3 "$here/plan_display_mode.py" \
    --width "$1" --height "$2" --refresh-rates "$3" --format words --wlr-randr-json -) || {
    status=$?
    printf '%s\n' "$plan"
    exit "$status"
}
printf '%s\n' "$plan"

# shellcheck disable=SC2086 # the plan is three words, split on purpose
set -- $plan
if [ "$1" = apply ]; then
    exec wlr-randr --output "$2" --mode "$3" --scale 1
fi
