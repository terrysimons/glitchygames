# Written by ansible/roles/ai_service: overrides go in {{ agent.label }}.env.runtime beside this file
AI_ROLE={{ agent.role | quote }}
{% if agent.role == 'api' %}
AI_SIDECAR={{ ai_sidecar_directory | quote }}
GLITCHYGAMES_AI_SERVICE_CONFIG={{ (ai_service_config_directory ~ '/service.json') | quote }}
{% else %}
AI_LLAMA_SERVER={{ (llama_cpp_install_directory ~ '/bin/llama-server') | quote }}
AI_MODEL_FILE={{ (ai_models_directory ~ '/' ~ agent.model_file) | quote }}
AI_ALIAS={{ agent.alias | quote }}
AI_PORT={{ agent.port | quote }}
AI_GPU_LAYERS={{ llama_cpp_gpu_layers | quote }}
AI_API_KEY_FILE={{ ai_service_api_key_file | quote }}
AI_SLEEP_IDLE_SECONDS={{ ai_service_sleep_idle_seconds | quote }}
{% endif %}
{% if agent.role == 'reasoning' %}
AI_VISION_FILE={{ (ai_models_directory ~ '/' ~ agent.vision_file) | quote }}
AI_CONTEXT_SIZE={{ ai_service_bonsai_context_size | quote }}
AI_OUTPUT_LIMIT={{ ai_service_bonsai_output_limit | quote }}
AI_CACHE_RAM_MIB={{ ai_service_bonsai_cache_ram_mib | quote }}
AI_REASONING_EFFORT={{ ai_service_bonsai_reasoning_effort | quote }}
{% elif agent.role == 'embedding' %}
AI_CONTEXT_SIZE={{ ai_service_qwen_context_size | quote }}
AI_MICRO_BATCH={{ ai_service_qwen_micro_batch | quote }}
{% endif %}
