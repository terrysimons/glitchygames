#!/bin/sh
# Removes the local AI service for this user: uninstall.sh [--remove-models]
# Models stay unless asked for, since they're large and slow to download again.
set -u

{% import 'platform_functions.sh.j2' as platform with context %}
{{ platform.user_root() }}
{{ platform.cache_root() }}
{{ platform.log_root() }}
{{ platform.forget_every_agent() }}
{{ platform.forget_package() }}

remove_models=false
if [ "${1:-}" = "--remove-models" ]; then
    remove_models=true
fi

# Every folder removed below is under the home, so none is removed without one
: "${HOME:?HOME is not set}"
user_root=$(user_root)

forget_every_agent

# On a Mac the programs share the user's folder; on Linux the package's are under /opt
rm -rf "${user_root:?}/agents" "${user_root:?}/runtime" "${user_root:?}/sidecar"
rm -rf "${user_root:?}/config" "${user_root:?}/share"
rm -rf "$(log_root)"
rm -rf "$(cache_root)"
forget_package

if [ "$remove_models" = true ]; then
    rm -rf "${user_root:?}/models"
fi

# Last: on a Mac this script is in here
rm -rf "${user_root:?}/bin"
rmdir "$user_root" 2>/dev/null
rmdir "$(dirname "$user_root")" 2>/dev/null

echo "Removed the GlitchyGames local AI service."
if [ "$remove_models" = false ] && [ -d "$user_root/models" ]; then
    echo "The models are still in $user_root/models (uninstall.sh --remove-models removes them)."
fi
exit 0
