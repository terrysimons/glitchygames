#!/bin/sh
# Starts and stops the local AI models on demand, so nothing uses memory until a game needs it:
#   ai-service.sh select    print the sizes this machine can run right now, starting nothing
#   ai-service.sh start     pick sizes the same way and start them
#   ai-service.sh stop      stop every model
#   ai-service.sh status    print what's running
# Prints key=value lines. Exits 3 when no model fits in the memory free right now, and 4 when a port
# is held by something else: AI is then unavailable and the game plays on without it.
#
# Each model is an agent of the platform's service manager (launchd or systemd), named by its label,
# that runs only when started from here: nothing starts at login.
set -u

{% import 'platform_functions.sh.j2' as platform with context %}
{{ platform.user_root() }}
{{ platform.total_memory_mb() }}
{{ platform.available_memory_mb() }}
{{ platform.agent_is_running() }}
{{ platform.start_agent_process() }}
{{ platform.stop_agent_process() }}
{{ platform.port_is_listening() }}
{{ platform.memory_tier() }}

models="$(user_root)/models"
config="$(user_root)/config"
api_label={{ ai_service_api_label }}
api_port={{ ai_service_api_port }}

# Left for the game, the system and whatever else is open. Provisional until measured from every
# game's peak on the Pi (plans/lucid-circuit-linux.md, 6.4.1)
game_reserve_mb={{ ai_service_game_reserve_mib }}
# Names the models the last start started, for the API (ai_service_selection_file_name)
selection_file="$config/{{ ai_service_selection_file_name }}"

# The labels and aliases are the ones the ai_service role lists its agents by (list_agents.yml)
bonsai_label() { echo "{{ ai_service_label_prefix }}.bonsai-2-$1.llama-cpp"; }
qwen_label() { echo "{{ ai_service_label_prefix }}.qwen3-embedding-$1.llama-cpp"; }
bonsai_alias() { echo "bonsai-2-$1"; }
qwen_alias() { echo "qwen3-embedding-$1"; }
bonsai_sizes="{{ ai_service_bonsai_tiers | map(attribute='size') | join(' ') }}"
qwen_sizes="{{ ai_models_qwen | list | join(' ') }}"

# Sets files, reserved_mb, minimum_mb and port for a size at a context: bonsai_facts SIZE CONTEXT
bonsai_facts() {
    case "$1" in
{% for tier in ai_service_bonsai_tiers %}
        {{ tier.size }})
            files="{{ ai_models_bonsai[tier.size].model.file }} {{ ai_models_bonsai[tier.size].vision.file }}"
            minimum_mb={{ tier.minimum_memory_mb }}
            port={{ ai_service_bonsai_ports[tier.size] }}
            case "$2" in
{% for context, reserved in ai_service_bonsai_reserved_mib.items() %}
                {{ context }}) reserved_mb={{ reserved[tier.size] }} ;;
{% endfor %}
            esac
            ;;
{% endfor %}
    esac
}
qwen_facts() {
    case "$1" in
{% for size, model in ai_models_qwen.items() %}
        {{ size }})
            files="{{ model.model.file }}"
            reserved_mb={{ ai_service_qwen_reserved_mib[size] }}
            port={{ ai_service_qwen_ports[size] }}
            ;;
{% endfor %}
    esac
}

files_present() {
    for file in $files; do
        [ -f "$models/$file" ] || return 1
    done
    return 0
}

# Physical memory says what a machine can ever run, and free memory what it can run now. Total
# memory picks the memory tier (memory_tier): Bonsai's context and prompt cache, and the Qwen beside
# it or none. Then the largest Bonsai size the size tiers allow whose reserved figure at that
# context, with its prompt cache at the tier's cap (--cache-ram fills as a session goes on: counted
# full, on every platform, the owner, 2026-11-19), the tier's Qwen and the game's reserve, fits in
# what's free. A smaller memory tier is never taken instead: the tier is the machine's. Overrides
# (AI_MEMORY_MB, AI_AVAILABLE_MB) are for testing the choice, and selection.env for a user who picks
# a size by hand. The default size (ai_service_default_bonsai_size; empty: the largest that fits)
# gives way to selection.env, and AI_BONSAI_SIZE beats both for one run: a size that isn't
# downloaded, or doesn't fit, still gets nothing. A size chosen by hand runs at the memory tier's
# context and cache too.
# Models already running stay and count as fitting, as what's free already leaves out what they
# hold: a running Bonsai size is kept, whatever the default, and only a model not yet running is
# checked against what's free. So a second game's start, while the first's models load or after one
# of them failed, starts only what's missing, or refuses naming it, and never stops a running one
select_sizes() {
    memory_mb=$(total_memory_mb)
    free_mb=$(available_memory_mb)
    budget_mb=$(( free_mb - game_reserve_mb ))

    if ! memory_tier "$memory_mb"; then
        echo "memory_mb=$memory_mb"
        echo "free_mb=$free_mb"
        echo "budget_mb=$budget_mb"
        echo "reason=memory-below-every-tier"
        return 3
    fi

    bonsai_running=$(running_size "$bonsai_sizes" bonsai_label)
    qwen_running=$(running_size "$qwen_sizes" qwen_label)

    bonsai_size=""
    bonsai_override={{ ai_service_default_bonsai_size | quote }}
    if [ -f "$config/selection.env" ]; then
        . "$config/selection.env"
    fi
    bonsai_override=${AI_BONSAI_SIZE:-$bonsai_override}
    if [ -n "$bonsai_running" ]; then
        bonsai_override=$bonsai_running
    fi

    qwen_size=${qwen_running:-$tier_qwen}
    qwen_needed_mb=0
    if [ "$qwen_size" != none ] && [ -z "$qwen_running" ]; then
        qwen_facts "$qwen_size"
        if ! files_present; then
            echo "reason=qwen-$qwen_size-not-downloaded"
            return 3
        fi
        qwen_needed_mb=$reserved_mb
    fi

    # Largest first, so the first that fits wins
    for size in {{ ai_service_bonsai_tiers | map(attribute='size') | reverse | join(' ') }}; do
        if [ -n "$bonsai_override" ] && [ "$size" != "$bonsai_override" ]; then
            continue
        fi
        bonsai_facts "$size" "$tier_context"
        files_present || continue
        if [ -z "$bonsai_override" ] && [ "$memory_mb" -lt "$minimum_mb" ]; then
            continue
        fi
        bonsai_needed_mb=$(( reserved_mb + tier_cache_ram_mib ))
        if [ "$size" = "$bonsai_running" ]; then
            bonsai_needed_mb=0
        fi
        needed_mb=$(( bonsai_needed_mb + qwen_needed_mb ))
        if [ "$needed_mb" -eq 0 ] || [ "$needed_mb" -le "$budget_mb" ]; then
            bonsai_size=$size
            break
        fi
    done

    echo "memory_mb=$memory_mb"
    echo "free_mb=$free_mb"
    echo "budget_mb=$budget_mb"
    if [ -z "$bonsai_size" ] && [ -n "$bonsai_running" ]; then
        # The running Bonsai always fits, so what doesn't is the Qwen beside it
        echo "reason=qwen-$qwen_size-does-not-fit"
        return 3
    fi
    if [ -z "$bonsai_size" ]; then
        echo "reason=nothing-fits"
        return 3
    fi
    echo "bonsai=$bonsai_size"
    echo "qwen=$qwen_size"
    echo "bonsai_context=$tier_context"
    echo "bonsai_cache_ram_mib=$tier_cache_ram_mib"
    return 0
}

# Bonsai's context and prompt cache for this machine's tier, in the agent's own LABEL.env.tier:
# write_tier_settings LABEL CONTEXT CACHE_RAM_MIB. Its runner reads LABEL.env, then this, then the
# user's LABEL.env.runtime, which this script never writes, so a user's own setting wins. It stays
# after a stop: a model started by hand then still runs at the tier's context
write_tier_settings() {
    mkdir -p "$config"
    printf 'AI_CONTEXT_SIZE=%s\nAI_CACHE_RAM_MIB=%s\n' "$2" "$3" > "$config/$1.env.tier.new" \
        && mv "$config/$1.env.tier.new" "$config/$1.env.tier"
}

# Names the models a start started, for the API's readiness: name_the_selection BONSAI_SIZE
# QWEN_SIZE (or none). Its variable isn't `models`: sh has no locals, and that is the models folder
name_the_selection() {
    selected_aliases="\"$(bonsai_alias "$1")\""
    if [ "$2" != none ]; then
        selected_aliases="$selected_aliases, \"$(qwen_alias "$2")\""
    fi
    mkdir -p "$config"
    printf '{"models": [%s]}\n' "$selected_aliases" > "$selection_file.new" \
        && mv "$selection_file.new" "$selection_file"
}

# A port held by anything else, another user's service included, is refused before starting
start_agent() {
    label=$1
    agent_port=$2
    agent_is_running "$label" && return 0
    if port_is_listening "$agent_port"; then
        echo "reason=port-$agent_port-in-use"
        return 4
    fi
    if ! start_agent_process "$label"; then
        echo "reason=could-not-start-$label"
        return 1
    fi
    return 0
}

# Every model agent, whichever sizes this machine has
model_labels() {
    for size in $bonsai_sizes; do
        bonsai_label "$size"
    done
    for size in $qwen_sizes; do
        qwen_label "$size"
    done
}

# The API last: it may be what's running this script, once the last game has gone
stop_all() {
    rm -f "$selection_file"
    for label in $(model_labels); do
        if agent_is_running "$label"; then
            stop_agent_process "$label"
        fi
    done
    if agent_is_running "$api_label"; then
        stop_agent_process "$api_label"
    fi
    return 0
}

# Which size of a model runs now, if any: running_size SIZES LABEL_FUNCTION
running_size() {
    for size in $1; do
        if agent_is_running "$("$2" "$size")"; then
            echo "$size"
            return 0
        fi
    done
    return 1
}

case "${1:-}" in
    select)
        select_sizes
        ;;
    start)
        # Another game may already have started some of them: select_sizes keeps those and counts
        # them as fitting, and start_agent leaves a running agent as it is
        selection=$(select_sizes)
        result=$?
        echo "$selection"
        [ "$result" -eq 0 ] || exit "$result"
        bonsai_size=$(echo "$selection" | sed -n 's/^bonsai=//p')
        qwen_size=$(echo "$selection" | sed -n 's/^qwen=//p')
        bonsai_context=$(echo "$selection" | sed -n 's/^bonsai_context=//p')
        bonsai_cache_ram_mib=$(echo "$selection" | sed -n 's/^bonsai_cache_ram_mib=//p')
        write_tier_settings "$(bonsai_label "$bonsai_size")" "$bonsai_context" "$bonsai_cache_ram_mib"
        bonsai_facts "$bonsai_size" "$bonsai_context"
        start_agent "$(bonsai_label "$bonsai_size")" "$port" || exit $?
        if [ "$qwen_size" != none ]; then
            qwen_facts "$qwen_size"
            start_agent "$(qwen_label "$qwen_size")" "$port" || exit $?
        fi
        name_the_selection "$bonsai_size" "$qwen_size"
        start_agent "$api_label" "$api_port" || exit $?
        ;;
    stop)
        stop_all
        ;;
    status)
        for label in $(model_labels) "$api_label"; do
            if agent_is_running "$label"; then
                echo "running=$label"
            fi
        done
        ;;
    *)
        echo "usage: ai-service.sh select|start|stop|status" >&2
        exit 64
        ;;
esac
