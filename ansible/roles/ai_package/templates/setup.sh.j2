#!/bin/sh
# Readies one user's part of the local AI service: the models this machine can run, the two keys,
# the settings, and on Linux which cores each part runs on. It starts nothing, since
# bin/ai-service.sh starts the models when a game loads. On a Mac launchd runs it once after the
# package installs; on Linux the package's setup unit runs it at every login, and Ansible runs it
# for the owner (plans/lucid-circuit-linux.md, 6.3). Rendered by ansible/roles/ai_package from the
# same variables the Ansible install uses, so the model list, the memory tiers and the agents can't
# drift apart. It's safe to run again: nothing already right is redone or rewritten.
# Exits 0 when done, and 1 on a failure the next run retries, such as a download.
set -u

{# The playbook's folder is on the template module's search path, so this reaches the other role's
   file without a copy (ansible-core's plugins/action/template.py adds the loader's base directory) #}
{% import 'roles/ai_service/templates/platform_functions.sh.j2' as platform with context %}
{{ platform.user_root() }}
{{ platform.program_root() }}
{{ platform.log_root() }}
{{ platform.total_memory_mb() }}
{{ platform.sha256_of() }}
{{ platform.machine_can_run_the_service() }}
{{ platform.ai_threads() }}
{{ platform.install_agent_definition() }}
{{ platform.place_the_cores() }}
{{ platform.reload_agent_definitions() }}
{{ platform.check_the_service_managers_data_home() }}
{{ platform.finish_setup_job() }}
{{ platform.take_the_setup_lock() }}

say() {
    echo "setup: $1"
}

# install_if_changed NEW TARGET: NEW takes TARGET's place only when they differ, so a run with
# nothing to do leaves every file as it was
install_if_changed() {
    if cmp -s "$1" "$2"; then
        rm -f "$1"
    else
        mv "$1" "$2"
    fi
}

# Text that sed's replacement takes literally
sed_literal() {
    printf '%s' "$1" | sed -e 's/[&|\\]/\\&/g'
}

# escaped_for KIND TEXT: TEXT for inside a single-quoted shell word (KIND shell) or a JSON string
# (KIND json), as sed's replacement takes it literally
escaped_for() {
    case "$1" in
        shell) text=$(printf '%s' "$2" | sed -e "s/'/'\\\\''/g") ;;
        json) text=$(printf '%s' "$2" | sed -e 's/[\\"]/\\&/g') ;;
    esac
    sed_literal "$text"
}

user_root=$(user_root)
program_root=$(program_root)
models="$user_root/models"
config="$user_root/config"
share="$program_root/share"

# fill_in KIND TEMPLATE: the package's template with this user's folders and home in place of its
# placeholders, each escaped for the KIND of file it lands in (escaped_for). None of the
# placeholders holds a character sed treats specially
fill_in() {
    sed -e "s|{{ ai_package_user_root_placeholder }}|$(escaped_for "$1" "$user_root")|g" \
        -e "s|{{ ai_package_program_root_placeholder }}|$(escaped_for "$1" "$program_root")|g" \
        -e "s|{{ ai_package_home_placeholder }}|$(escaped_for "$1" "$HOME")|g" \
        "$2"
}

mkdir -p "$models" "$config" "$(log_root)"

# One run at a time for this user root: the setup job at a login, the package's postinst and Ansible
# may start it together, and two runs would write the same .part files. The lock is a file in the
# root it guards, so every run for that root takes the same one whatever its environment, and the
# kernel holds it (take_the_setup_lock), so a run that dies frees it. A run that finds it taken
# leaves the work to the run holding it
take_the_setup_lock "$config/setup.lock"
case $? in
    0) ;;
    75)
        say "another setup run for $user_root is already running; it finishes the job"
        exit 0
        ;;
    *)
        say "could not take the setup lock $config/setup.lock; stopping"
        exit 1
        ;;
esac

if ! machine_can_run_the_service; then
    exit 0
fi

memory_mb=$(total_memory_mb)
bonsai_size=""
{% for tier in ai_service_bonsai_tiers %}
if [ "$memory_mb" -ge {{ tier.minimum_memory_mb }} ]; then bonsai_size={{ tier.size }}; fi
{% endfor %}
qwen_size={{ ai_service_qwen_size }}

# The default size (empty: the one memory allows), then a choice the user made, which stays
bonsai_override={{ ai_service_default_bonsai_size | quote }}
if [ -f "$config/selection.env" ]; then
    . "$config/selection.env"
fi
[ -z "$bonsai_override" ] || bonsai_size=$bonsai_override
say "memory ${memory_mb} MB: downloading Bonsai $bonsai_size, Qwen $qwen_size"

# fetch FILE REPOSITORY REVISION BYTES SHA256: into FILE.part, resuming one an earlier run left,
# and to FILE only once its SHA-256 matches
fetch() {
    file=$1
    url="{{ ai_models_base_url }}/$2/resolve/$3/$1"
    bytes=$4
    sha256=$5
    if [ -f "$models/$file" ] && [ "$(sha256_of "$models/$file")" = "$sha256" ]; then
        return 0
    fi
    available_kb=$(df -k "$models" | tail -1 | awk '{print $4}')
    if [ $(( available_kb * 1024 )) -lt "$(( bytes + {{ ai_models_free_margin_bytes }} ))" ]; then
        say "not enough disk space for $file"
        return 1
    fi
    say "downloading $file"
    if ! curl --fail --location --silent --show-error --continue-at - \
        --connect-timeout 30 --speed-time 60 --speed-limit 1024 \
        --retry 5 --retry-delay 5 --retry-all-errors \
        --output "$models/$file.part" "$url"; then
        say "could not download $file; it resumes on the next run"
        return 1
    fi
    if [ "$(sha256_of "$models/$file.part")" != "$sha256" ]; then
        rm -f "$models/$file.part"
        say "$file had the wrong SHA-256 and was discarded"
        return 1
    fi
    mv "$models/$file.part" "$models/$file"
}

failed=false
case "$bonsai_size" in
{% for size, model in ai_models_bonsai.items() if size in ai_models_bonsai_sizes %}
    {{ size }})
        fetch {{ model.model.file }} {{ model.repository }} {{ model.revision }} {{ model.model.bytes }} {{ model.model.sha256 }} || failed=true
        fetch {{ model.vision.file }} {{ model.repository }} {{ model.revision }} {{ model.vision.bytes }} {{ model.vision.sha256 }} || failed=true
        ;;
{% endfor %}
    *)
        say "unknown Bonsai size $bonsai_size"
        failed=true
        ;;
esac
case "$qwen_size" in
{% for size, model in ai_models_qwen.items() if size in ai_models_qwen_sizes %}
    {{ size }})
        fetch {{ model.model.file }} {{ model.repository }} {{ model.revision }} {{ model.model.bytes }} {{ model.model.sha256 }} || failed=true
        ;;
{% endfor %}
    *)
        say "unknown Qwen size $qwen_size"
        failed=true
        ;;
esac
if [ "$failed" = true ]; then
    say "stopping; the service starts once its models are here"
    exit 1
fi

# A key is made only when there is none, so a failed openssl must leave no file at all: an empty or
# partial key would stay for good. It's written beside its place and moved in only when whole
for key in worker-api-key service-api-key; do
    [ ! -f "$config/$key" ] || continue
    if ! (umask 077 && openssl rand -hex 32 > "$config/$key.new") || [ ! -s "$config/$key.new" ]; then
        rm -f "$config/$key.new"
        say "could not make $key with openssl; stopping"
        exit 1
    fi
    mv "$config/$key.new" "$config/$key"
done

# The settings likewise: a template missing from the package, or one that can't be read, stops the
# run and leaves the settings already there as they were
service_template="$share/agents/service.json.template"
if [ ! -f "$service_template" ] \
    || ! fill_in json "$service_template" > "$config/service.json.new"; then
    rm -f "$config/service.json.new"
    say "could not fill in $service_template; stopping"
    exit 1
fi
install_if_changed "$config/service.json.new" "$config/service.json"
# Each agent's settings, with this machine's thread count in place of the one the package was
# built with
threads=$(ai_threads)
for template in "$share"/agents/*.env.template; do
    if [ ! -f "$template" ]; then
        say "no agent settings in $share/agents; stopping"
        exit 1
    fi
    label=$(basename "$template" .env.template)
    # Two steps rather than a pipe, whose status would be sed's alone
    if ! fill_in shell "$template" > "$config/$label.env.filled" \
        || ! sed -e "s|^AI_THREADS=.*|AI_THREADS='$threads'|" "$config/$label.env.filled" \
            > "$config/$label.env.new"; then
        rm -f "$config/$label.env.filled" "$config/$label.env.new"
        say "could not fill in the settings for $label; stopping"
        exit 1
    fi
    rm -f "$config/$label.env.filled"
    install_if_changed "$config/$label.env.new" "$config/$label.env"
    install_agent_definition "$label" || exit 1
done

# Every AI unit shares the AI's cores: each model's, the API's and this setup job's
if ! place_the_cores {{ (ai_service_agents | map(attribute='label') | list + [ai_package_setup_label]) | join(' ') }}; then
    say "could not write the CPU placement; stopping"
    exit 1
fi
reload_agent_definitions
check_the_service_managers_data_home

say "done"
finish_setup_job
exit 0
